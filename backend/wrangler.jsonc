{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "adviento-lucia-editor",
  "main": "worker.mjs",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://TU_USUARIO.github.io",
    "GITHUB_OWNER": "TU_USUARIO",
    "GITHUB_REPO": "adviento-lucia-datos",
    "GITHUB_BRANCH": "main",
    "ADMIN_USERNAME": "Manuel"
  },
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": {"limit": 5, "period": 60} }
  ]
}
